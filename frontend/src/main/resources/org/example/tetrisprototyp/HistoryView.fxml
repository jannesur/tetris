<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.ListView?>
<VBox fx:controller="org.example.tetrisprototyp.MenuController.HistoryController"
      alignment="CENTER"
      spacing="30.0"
      style="-fx-background-color: linear-gradient(to bottom, #1a1a2e, #16213e);"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Titel -->
    <Label text="Spielhistorie"
           textFill="#00ffff"
           style="-fx-font-size: 56px; -fx-font-weight: bold;">
        <font>
            <Font name="System Bold" size="56"/>
        </font>
        <effect>
            <DropShadow color="#00ffff" radius="15" spread="0.3"/>
        </effect>
    </Label>

    <Label fx:id="statsLabel"
           text="Spiele: 0 | Bestscore: 0 | Best-Level: 0"
           textFill="#00ffff"
           style="-fx-font-size: 18px; -fx-font-weight: bold;">
        <effect>
            <DropShadow color="#00ffff" radius="6"/>
        </effect>
    </Label>

    <!-- LISTVIEW FÜR HISTORIE -->
    <ListView fx:id="historyList"
              prefWidth="500"
              prefHeight="400"
              style="-fx-background-color: #0f0f1f; -fx-control-inner-background: #0f0f1f;
                     -fx-background-radius: 10; -fx-border-radius: 10;
                     -fx-border-color: #00ffff; -fx-border-width: 2;
                     -fx-text-fill: white;" />

    <!-- Zurück-Button -->
    <Button fx:id="backButton"
            text="Zurück zum Menü"
            onAction="#backToMenu"
            prefWidth="260"
            prefHeight="55"
            styleClass="menu-button"
            style="-fx-background-color: #ff3b30; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 12;">
        <effect>
            <DropShadow color="#00000080" radius="10" offsetY="5"/>
        </effect>
    </Button>

    <!-- Footer -->
    <Label text="© Tetris"
           textFill="#444466"
           style="-fx-font-size: 12px;"/>
</VBox>
