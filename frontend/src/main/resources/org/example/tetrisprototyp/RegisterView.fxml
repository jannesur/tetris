<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:controller="org.example.tetrisprototyp.MenuController.RegisterController"
      alignment="CENTER"
      spacing="35"
      style="-fx-background-color: linear-gradient(to bottom, #1a1a2e, #16213e);"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets top="60" right="40" bottom="60" left="40"/>
    </padding>

    <!-- Titel -->
    <Label text="TETRIS"
           textFill="white"
           style="-fx-font-size: 82px; -fx-font-weight: bold;">
        <font><Font name="System Bold" size="82"/></font>
        <effect><DropShadow color="#00ffff" radius="15" spread="0.3"/></effect>
    </Label>


    <!-- Registrierungs-Formular -->
    <VBox spacing="22" alignment="CENTER"
          style="-fx-background-color: #0f0f1e; -fx-background-radius: 20; -fx-padding: 45 40 45 40;"
          maxWidth="420">

        <Label text="Registrieren"
               textFill="#00d0ff"
               style="-fx-font-size: 36px; -fx-font-weight: bold;"/>

        <TextField fx:id="usernameField"
                   promptText="Benutzername"
                   prefHeight="58"
                   styleClass="styled-textfield"/>

        <PasswordField fx:id="passwordField"
                       promptText="Passwort"
                       prefHeight="58"
                       styleClass="styled-textfield"/>

        <PasswordField fx:id="passwordConfirmField"
                       promptText="Passwort wiederholen"
                       prefHeight="58"
                       styleClass="styled-textfield"/>

        <!-- Registrieren-Button -->
        <Button text="Konto erstellen"
                onAction="#performRegister"
                prefWidth="Infinity"
                prefHeight="65"
                styleClass="menu-button"
                style="-fx-background-color: #00d0ff; -fx-text-fill: white;
                       -fx-font-size: 22px; -fx-font-weight: bold; -fx-background-radius: 14;">
            <effect><DropShadow color="#00000090" radius="12" offsetY="6"/></effect>
        </Button>

        <!-- Erfolgs-/Fehlermeldung -->
        <Label fx:id="messageLabel"
               text=""
               textFill="#ffc000"
               alignment="CENTER"
               wrapText="true"
               minHeight="50"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    </VBox>

    <!-- Zurück-Button (oben links) -->
    <Button text="Zurück"
            onAction="#goBack"
            styleClass="menu-button"
            style="-fx-background-color: transparent; -fx-text-fill: #88aaff;
               -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 15 20 15 20;
               -fx-alignment: CENTER_LEFT;"
            alignment="TOP_LEFT"
            VBox.vgrow="ALWAYS">
        <effect>
            <DropShadow color="#00000040" radius="3"/>
        </effect>
    </Button>

    <!-- Footer -->
    <Label text="© 2025 Janne Melina Surborg und Konstantin Königshofen – HAW Ostfalia"
           textFill="#444466"
           style="-fx-font-size: 12px;"/>
</VBox>
