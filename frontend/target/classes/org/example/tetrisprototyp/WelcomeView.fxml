<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:controller="org.example.tetrisprototyp.Menu.WelcomeController"
      alignment="CENTER"
      spacing="40"
      style="-fx-background-color: linear-gradient(to bottom, #1a1a2e, #16213e);"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets top="80" right="40" bottom="80" left="40"/>
    </padding>

    <!-- Großer Titel -->
    <Label text="TETRIS"
           textFill="white"
           style="-fx-font-size: 96px; -fx-font-weight: bold; -fx-letter-spacing: 4px;">
        <font>
            <Font name="System Bold" size="96"/>
        </font>
        <effect>
            <DropShadow color="#00ffff" radius="20" spread="0.4"/>
        </effect>
    </Label>


    <!-- Buttons -->
    <VBox spacing="25" alignment="CENTER">

        <!-- LOGIN BUTTON -->
        <Button fx:id="loginButton"
                text="Login"
                onAction="#openLogin"
                prefWidth="360"
                prefHeight="80"
                styleClass="menu-button"
                style="-fx-background-color: #00ff88; -fx-text-fill: black;
                       -fx-font-size: 24px; -fx-font-weight: bold;
                       -fx-background-radius: 16; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#00000090" radius="15" offsetY="8"/>
            </effect>
        </Button>

        <!-- REGISTER BUTTON -->
        <Button fx:id="registerButton"
                text="Registrieren"
                onAction="#openRegister"
                prefWidth="360"
                prefHeight="80"
                styleClass="menu-button"
                style="-fx-background-color: #0066ff; -fx-text-fill: white;
                       -fx-font-size: 24px; -fx-font-weight: bold;
                       -fx-background-radius: 16; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#00000090" radius="15" offsetY="8"/>
            </effect>
        </Button>

        <!-- EXIT BUTTON -->
        <Button fx:id="exitButton"
                text="Beenden"
                onAction="#exitApplication"
                prefWidth="360"
                prefHeight="80"
                styleClass="menu-button"
                style="-fx-background-color: #ff3b30; -fx-text-fill: white;
               -fx-font-size: 24px; -fx-font-weight: bold;
               -fx-background-radius: 16; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#00000090" radius="15" offsetY="8"/>
            </effect>
        </Button>

    </VBox>

    <!-- Footer -->
    <Label text="© 2025 Janne Melina Surborg und Konstantin Königshofen – HAW Ostfalia"
           textFill="#444466"
           style="-fx-font-size: 12px;"/>
</VBox>